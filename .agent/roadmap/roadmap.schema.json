{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marketscalping.local/schemas/master-roadmap.schema.json",
  "title": "MarketScalping Master Roadmap",
  "type": "object",
  "description": "Machine-readable planning artifact for the project roadmap. This document is planning-only and not authoritative runtime state.",
  "required": ["roadmap_id", "version", "name", "stages"],
  "additionalProperties": false,
  "properties": {
    "roadmap_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "source_of_truth": {"type": "string", "enum": ["planning-only"]},
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/stage"
      }
    }
  },
  "$defs": {
    "stage": {
      "type": "object",
      "additionalProperties": true,
      "required": ["stage_id", "title", "description", "depends_on", "risk_level", "owner", "target_workflow_state", "required_evidence", "exit_criteria", "human_approval_required"],
      "properties": {
        "stage_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "parent_stage_id": {"type": ["string", "null"]},
        "depends_on": {"type": "array", "items": {"type": "string"}},
        "risk_level": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
        "owner": {"type": "string", "minLength": 1},
        "target_workflow_state": {"type": "string", "minLength": 1},
        "required_evidence": {"type": "array", "items": {"type": "string"}},
        "exit_criteria": {"type": "array", "items": {"type": "string"}},
        "human_approval_required": {"type": "boolean"},
        "evidence_refs": {"type": "array", "items": {"type": "string"}},
        "notes": {"type": "string"}
      }
    }
  }
}
